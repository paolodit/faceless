# Copy this file to .env and add your own API key.
# Never commit your real .env file.

# Required only when using OpenAI transcription or OpenAI image generation.
OPENAI_API_KEY=

# Required only when using Magnific image generation, upscaling, or scene video generation.
MAGNIFIC_API_KEY=

# Optional. Reserved for future Magnific webhook verification/callback flows.
MAGNIFIC_WEBHOOK_KEY=

# Optional. Required only when using video-pack stock-assets with real free stock providers.
PEXELS_API_KEY=
PIXABAY_API_KEY=
