# Copy this file to .env when you want to use OpenAI-backed features.
#
# PowerShell:
#   Copy-Item .env.example .env
#
# The CLI loads .env automatically through dotenv.

# Required only for:
# - video-pack transcribe --provider openai
# - video-pack preview --provider openai
# - video-pack generate-images --provider openai
# - video-pack generate-thumbnails --provider openai
OPENAI_API_KEY=
